APP_NAME="FCI Doc Assist"
ENVIRONMENT=development
API_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fci_docassist
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_PROVIDER=local
VECTOR_STORE=chroma
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BATCH_SIZE=8
MAX_STORED_CHUNKS=20000

CHROMA_PATH=./.chroma
CHROMA_COLLECTION=fci_circulars
TEMP_UPLOAD_TTL_MINUTES=60
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=100
MAX_DOCUMENT_CHUNKS=300

FCI_CIRCULAR_URLS=https://fci.gov.in/circular
FCI_REQUEST_TIMEOUT=30
SCHEDULER_ENABLED=true
CRAWL_ON_START=true
CRAWLER_ADMIN_EMAILS=svarsha.t@gmail.com
CRAWLER_DAILY_CRON_HOUR=2
CRAWLER_MAX_DOCUMENTS_PER_RUN=5
CRAWLER_JOB_TOKEN=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
